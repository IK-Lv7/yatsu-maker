# このファイルをコピーして .env (ローカル) や GitHub Actions の Secrets に設定する。
# .env / .env.local はコミットしないこと(.gitignore済み)。

# --- YouTube Data API v3 ---
# タイトル取得 (ml/fetch/fetch_titles.py) に使用
YOUTUBE_API_KEY=
# 対象チャンネルのID
YOUTUBE_CHANNEL_ID=
# タイトル正規化時に除去するチャンネル名等(|区切り、複数可)
TITLE_NOISE_STRINGS=

# --- Supabase ---
# SUPABASE_URL と NEXT_PUBLIC_SUPABASE_URL は同じプロジェクトURL。
# Python側(ml/common/supabase_client.py, fetch/generateバッチ)は SUPABASE_URL を、
# Next.js側(web/)は NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY を参照する。
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# バッチ・投稿/いいねAPIの書き込み専用。フロントのクライアントバンドルには絶対に含めない
# Supabaseダッシュボードの「秘密の(secret)キー」(sb_secret_... または旧service_role)
SUPABASE_SERVICE_ROLE_KEY=

# --- 通知 ---
# バッチ失敗時の通知先(未実装 / TODO)
DISCORD_WEBHOOK_URL=
